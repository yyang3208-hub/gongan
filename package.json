{
  "name": "gongan-operations-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent video and drone operations platform",
  "engines": { "node": ">=24.13.1" },
  "scripts": {
    "postinstall": "node scripts/prepare-map.mjs",
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs && node scripts/test-browser.mjs",
    "test:api": "node --test tests/*.test.mjs",
    "test:e2e": "node scripts/test-browser.mjs"
  },
  "dependencies": {
    "cesium": "1.146.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@playwright/test": "1.64.1"
  }
}
