FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY public ./public
COPY shared ./shared
COPY server ./server
COPY tests ./tests
COPY scripts ./scripts
COPY server.mjs ./
RUN npm run build

FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends gdal-bin python3-gdal python3-pil && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/dist ./
ENV PORT=3221 GONGAN_LISTEN_HOST=0.0.0.0 IMAGERY_GDAL_TRANSLATE=/usr/bin/gdal_translate IMAGERY_GDAL_INFO=/usr/bin/gdalinfo IMAGERY_GDAL2TILES=/usr/bin/gdal2tiles.py IMAGERY_PYTHON=/usr/bin/python3
EXPOSE 3221
CMD ["node", "server.mjs"]
